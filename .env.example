# 모두 선택 사항입니다. 값이 없으면 아래 기본 동작을 합니다.

# 세션 쿠키 서명 키. 없으면 처음 실행할 때 무작위로 만들어 DB에 보관합니다.
SESSION_SECRET=

# 새한 프라텍(saehan) 관리자 첫 비밀번호. 없으면 무작위로 만들어 data/admin-password.txt 에 적습니다.
ADMIN_PASSWORD=

# SQLite 파일 위치 (기본 data/saehan.db)
DB_PATH=

# 체험(데모) 회사 끄기: off 로 두면 첫 화면의 체험 계정이 사라집니다.
DEMO=on

# 요청 만료용 예약 작업(/api/cron)을 외부에서 부를 때 쓰는 비밀 값
CRON_SECRET=
